# ============================================================
# Figura Certa — variáveis de ambiente
# Copie para .env e preencha. NUNCA commite o .env real.
# ============================================================

# Database (Neon — https://neon.tech) — no painel, escolha "Prisma" no Connect
DATABASE_URL=   # conexão pooled (…-pooler…)
DIRECT_URL=     # conexão direta (sem -pooler), usada nas migrations

# Auth.js v5
AUTH_SECRET=              # gere com: openssl rand -base64 32
AUTH_GOOGLE_ID=           # Google Cloud Console > OAuth Client ID
AUTH_GOOGLE_SECRET=
AUTH_RESEND_KEY=          # Resend API Key (para magic links)

# Stripe (https://dashboard.stripe.com)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_PRO=

# Resend (emails transacionais)
RESEND_API_KEY=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
